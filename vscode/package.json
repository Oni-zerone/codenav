{
  "name": "codenav-graph",
  "displayName": "CodeNav Graph",
  "description": "Visualize the code graph built by codenav (.codenav/graph.json).",
  "version": "0.1.0",
  "publisher": "codenav",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Oni-zerone/codenav.git",
    "directory": "vscode"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "main": "./out/src/extension.js",
  "activationEvents": [
    "workspaceContains:.codenav/graph.json"
  ],
  "contributes": {
    "commands": [
      {
        "command": "codenav.showGraph",
        "title": "Show Code Graph",
        "category": "CodeNav",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "codenav.revealInGraph",
        "title": "Reveal in Code Graph",
        "category": "CodeNav"
      },
      {
        "command": "codenav.reindex",
        "title": "Re-index Repository",
        "category": "CodeNav"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "codenav.revealInGraph",
          "when": "resourceScheme == file",
          "group": "navigation@90"
        }
      ],
      "explorer/context": [
        {
          "command": "codenav.revealInGraph",
          "when": "resourceScheme == file && !explorerResourceIsFolder",
          "group": "navigation@90"
        }
      ],
      "editor/title": [
        {
          "command": "codenav.showGraph",
          "when": "codenav.hasGraph",
          "group": "navigation@90"
        }
      ]
    },
    "configuration": {
      "title": "CodeNav",
      "properties": {
        "codenav.executable": {
          "type": "string",
          "default": "codenav",
          "description": "Path of the codenav binary used by \"Re-index Repository\"."
        },
        "codenav.maxNodes": {
          "type": "number",
          "default": 400,
          "minimum": 20,
          "description": "Maximum number of nodes drawn in one view. Larger views are truncated (the most connected nodes are kept)."
        },
        "codenav.moduleDepth": {
          "type": "number",
          "default": 2,
          "minimum": 1,
          "description": "Directory depth that defines a component in the Modules view."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p . && node scripts/copy-vendor.js",
    "watch": "tsc -watch -p .",
    "vscode:prepublish": "npm run compile",
    "test": "npm run compile && node --test out/test/*.test.js",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "cytoscape": "3.33.1",
    "cytoscape-fcose": "2.2.0"
  }
}
